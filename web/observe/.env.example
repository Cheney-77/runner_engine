# Set these in the shell, or explicitly load this file before starting.
# Observatory does NOT read or modify the existing publishing config.
OBS_PUBLISH_DB_URL=
OBS_BUILD_DB_URL=
OBS_RUNNER_DB_URL=
# SQLite: sqlite:////absolute/path/service.db
# PostgreSQL: postgresql://readonly-user:password@db-host:5432/database
OBS_PUBLISH_DB_SCHEMA=public
OBS_BUILD_DB_SCHEMA=public
OBS_RUNNER_DB_SCHEMA=public

# Optional JSON config describing your actual DB tables/columns.
# OBS_TABLE_MAP_FILE=/absolute/path/to/observability-map.json

# OpenSandbox lifecycle API; can be http://hostname:8080 or .../v1
OBS_SANDBOX_URL=
OBS_SANDBOX_API_KEY=
OBS_SANDBOX_PAGE_SIZE=50
OBS_SANDBOX_MAX_ITEMS=200
# Avoid overwhelming the sandbox API when hundreds of containers run.
OBS_EXECD_SAMPLE_LIMIT=30

# Live CPU / memory readings require OpenSandbox execd metrics via a
# separately approved endpoint origin. Host and port, comma-separated:
# OBS_EXECD_ALLOWED_ORIGINS=https://sandbox-gateway.example.com
# Exact origin (scheme://hostname[:port]); no wildcards.
OBS_EXECD_ALLOWED_ORIGINS=
OBS_EXECD_METRICS=0

# Recommended when exposing beyond 127.0.0.1 (TLS / reverse proxy required).
OBS_BASIC_USER=
OBS_BASIC_PASSWORD=
