# Unified service: one process, no browser login. No ADMIN_USER / BASIC passwords.
# Existing Publish Web settings remain unchanged.
MPR_PUBLISH_SERVICE_URL=http://127.0.0.1:9090

# The 3 PostgreSQL DATABASE URLs are independent:
OBS_PUBLISH_DB_URL=postgresql://observer:PASSWORD@PG_HOST:5432/publish_db
OBS_BUILD_DB_URL=postgresql://observer:PASSWORD@PG_HOST:5432/build_db
OBS_RUNNER_DB_URL=postgresql://observer:PASSWORD@PG_HOST:5432/runner_db

# Each URL additionally uses its OWN PostgreSQL SCHEMA:
OBS_PUBLISH_DB_SCHEMA=publish
OBS_BUILD_DB_SCHEMA=build
OBS_RUNNER_DB_SCHEMA=runner

# No OBS_TABLE_MAP_FILE. Real table names come from the supplied 3 DDLs.
OBS_SANDBOX_URL=http://SANDBOX_HOST:8080/v1
OBS_SANDBOX_API_KEY=
OBS_SANDBOX_PAGE_SIZE=50
OBS_SANDBOX_MAX_ITEMS=200
OBS_EXECD_METRICS=0
OBS_EXECD_ALLOWED_ORIGINS=
OBS_EXECD_SAMPLE_LIMIT=30

# Optional console-only metadata and audited CRUD (console_ops SQL migration).
ADMIN_DB_URL=postgresql://console_ops_role:PASSWORD@PG_HOST:5432/admin_db

# Optional service-owned retry for FAILED build environments:
ADMIN_BUILD_SERVICE_URL=
ADMIN_BUILD_BEARER_TOKEN=

# NO web login. Bind to 127.0.0.1 by default.
# For remote access (private network/firewall or VPN only), consciously opt in:
# CONSOLE_ALLOW_REMOTE_NO_AUTH=1
# CONSOLE_PUBLIC_ORIGIN=https://console.internal.example
# CONSOLE_PUBLIC_ORIGIN must equal the browser Origin, no path or trailing slash.
# HTTP private-network origin requires CONSOLE_ALLOW_REMOTE_NO_AUTH=1.
